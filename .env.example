# All optional - defaults work out of the box. Set as environment variables before starting the backend.
AUTOREMED_DB_PATH=backend/data/autoremed.db
AUTOREMED_AUTOSTART_MONITORING=true
AUTOREMED_STEP_DELAY=1.5          # seconds between workflow phases (so the dashboard can show progress)
AUTOREMED_LOG_LEVEL=INFO
AUTOREMED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTOREMED_METRICS_RETENTION=5000
AUTOREMED_HOST_DISK_PATH=         # default: filesystem root
AUTOREMED_WORKER_THREADS=8
